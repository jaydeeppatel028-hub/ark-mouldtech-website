# Copy this file to .env.local for local work. On Hostinger, enter the same
# names and values in the Node.js app's environment variables screen.
# Never commit real values. .env and .env.local are ignored by git.

# Public address of the website (used for canonical links, sitemap and structured data)
SITE_URL=https://www.arkmouldtech.com

# "off" hides placeholder slots and lets search engines index the site. Leave unset while previewing.
SITE_PREVIEW=

# MySQL / MariaDB connection. Without it the site shows the starter content
# from src/content/site.ts and the admin panel cannot be used.
# Format: mysql://USER:PASSWORD@HOST:3306/DATABASE_NAME
# Use 127.0.0.1 as HOST (Hostinger requires it; on cPanel hosts try localhost if 127.0.0.1 is refused), for example
# mysql://u123456789_ark:PASSWORD@127.0.0.1:3306/u123456789_ark
# If the password contains symbols such as @ : / # ? encode them (e.g. @ becomes %40).
DATABASE_URL=

# One-time secret for creating the first admin login at /admin/setup.
# Use a long random value (at least 16 characters). The setup page closes
# itself once an admin exists; you can then delete this variable.
SETUP_TOKEN=

# Outgoing email for inquiry alerts (for example Hostinger email or Gmail with an app password).
# Hostinger email: SMTP_HOST=smtp.hostinger.com, SMTP_PORT=465. Port 465 uses SSL; 587 uses STARTTLS.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Sender shown on alerts, for example: ARK Mouldtech Website <website@arkmouldtech.com>
SMTP_FROM=
# Where inquiry alerts go. Defaults to the primary email in Company info (nitin@arkmouldtech.com).
INQUIRY_TO=
